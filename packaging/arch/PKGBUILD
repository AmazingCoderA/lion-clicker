pkgname=lion-autoclicker
pkgver=0.1.0
pkgrel=1
_commit=REPLACE_WITH_COMMIT
pkgdesc='Configurable desktop autoclicker written in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/AmazingCoderA/lion-clicker'
license=('GPL-3.0-only')
depends=('libx11' 'libxkbcommon')
makedepends=('cargo' 'git')
source=("git+https://github.com/AmazingCoderA/lion-clicker.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/lion-clicker"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/lion-clicker"
  install -Dm755 target/release/lion-autoclicker "${pkgdir}/usr/bin/lion-autoclicker"
  install -Dm644 packaging/io.github.lionautoclicker.LionAutoclicker.desktop \
    "${pkgdir}/usr/share/applications/io.github.lionautoclicker.LionAutoclicker.desktop"
  install -Dm644 packaging/io.github.lionautoclicker.LionAutoclicker.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.lionautoclicker.LionAutoclicker.metainfo.xml"
  install -Dm644 packaging/io.github.lionautoclicker.LionAutoclicker.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.github.lionautoclicker.LionAutoclicker.svg"
}
